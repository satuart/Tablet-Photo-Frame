<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/settings_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/menu_scrim_background"
    android:clickable="true"
    android:focusable="true">

    <ScrollView
        android:layout_width="@dimen/settings_card_width"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:maxHeight="560dp">

        <LinearLayout
            android:id="@+id/settings_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_menu_card"
            android:orientation="vertical"
            android:paddingBottom="8dp">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/menu_row_padding_horizontal"
                android:paddingTop="@dimen/menu_row_padding_vertical"
                android:paddingEnd="8dp"
                android:paddingBottom="@dimen/menu_row_padding_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/settings_title"
                    android:textColor="@color/white"
                    android:textSize="20sp" />

                <ImageButton
                    android:id="@+id/button_close_settings"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/settings_close"
                    app:srcCompat="@drawable/ic_back" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/menu_divider_height"
                android:background="@color/menu_divider" />

            <!-- Photo folder -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/menu_row_padding_horizontal"
                android:paddingTop="@dimen/menu_row_padding_vertical"
                android:paddingEnd="@dimen/menu_row_padding_horizontal"
                android:paddingBottom="@dimen/menu_row_padding_vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/settings_photo_folder_label"
                    android:textColor="@color/white"
                    android:textSize="16sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/text_photo_folder_path"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="middle"
                        android:maxLines="1"
                        android:textColor="@color/menu_hint_text"
                        android:textSize="13sp"
                        tools:text="/sdcard/Pictures" />

                    <TextView
                        android:id="@+id/button_change_folder"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:background="?attr/selectableItemBackground"
                        android:fontFamily="sans-serif-medium"
                        android:padding="8dp"
                        android:text="@string/settings_change_folder"
                        android:textColor="@color/gold_accent"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/menu_divider_height"
                android:background="@color/menu_divider" />

            <!-- Interval stepper -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/menu_row_padding_horizontal"
                android:paddingTop="@dimen/menu_row_padding_vertical"
                android:paddingEnd="@dimen/menu_row_padding_horizontal"
                android:paddingBottom="@dimen/menu_row_padding_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/settings_interval_label"
                    android:textColor="@color/white"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/button_interval_minus"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/settings_interval_decrease"
                    android:gravity="center"
                    android:text="−"
                    android:textColor="@color/gold_accent"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/text_interval_value"
                    android:layout_width="64dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    tools:text="30 sec" />

                <TextView
                    android:id="@+id/button_interval_plus"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/settings_interval_increase"
                    android:gravity="center"
                    android:text="+"
                    android:textColor="@color/gold_accent"
                    android:textSize="20sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/menu_divider_height"
                android:background="@color/menu_divider" />

            <!-- Night mode toggle -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/menu_row_padding_horizontal"
                android:paddingTop="@dimen/menu_row_padding_vertical"
                android:paddingEnd="@dimen/menu_row_padding_horizontal"
                android:paddingBottom="@dimen/menu_row_padding_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/settings_night_mode_label"
                    android:textColor="@color/white"
                    android:textSize="16sp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_night_mode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/group_night_times"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/menu_row_padding_horizontal"
                android:paddingEnd="@dimen/menu_row_padding_horizontal"
                android:paddingBottom="@dimen/menu_row_padding_vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_night_from_label"
                        android:textColor="@color/menu_hint_text"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/text_night_start"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:padding="8dp"
                        android:textColor="@color/gold_accent"
                        android:textSize="14sp"
                        tools:text="10:00 PM" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_night_until_label"
                        android:textColor="@color/menu_hint_text"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/text_night_end"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:padding="8dp"
                        android:textColor="@color/gold_accent"
                        android:textSize="14sp"
                        tools:text="7:00 AM" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
